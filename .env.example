# Copy to .env.local for a DEVELOPMENT or STAGING build. Never commit real values.
# Production builds must NOT set these (check:release fails if backend code is bundled).
# The anon key is public by design (row-level security protects the data); the service-role key
# must never appear in any VITE_ variable or in the app.
VITE_BACKEND_ENV=development
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-the-local-anon-key
# Encrypted database (D11) – off by default
VITE_DB_ENCRYPTION=false
