{
  "name": "mitzvot-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "ios:open": "npm run cap:sync && cap open ios",
    "android:open": "npm run cap:sync && cap open android",
    "check:release": "node scripts/ci/check-release.mjs",
    "check:secrets": "node scripts/ci/check-secrets.mjs",
    "check:licenses": "node scripts/ci/check-licenses.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:release && npm run check:secrets && npm run check:licenses && npm run check:versions && npm run check:seed",
    "e2e": "npm run build && node scripts/e2e/scenarios.mjs",
    "check:distribution": "node scripts/ci/check-distribution.mjs",
    "check:versions": "node scripts/ci/check-versions.mjs",
    "test:db": "node scripts/db/test-db.mjs",
    "check:seed": "node scripts/db/gen-seed.mjs --check"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/frank-ruhl-libre": "5.3.0",
    "@fontsource/heebo": "5.3.0",
    "@hebcal/core": "^5.10.1",
    "@hebcal/learning": "^5.1.2",
    "@supabase/supabase-js": "2.119.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "pg": "8.16.3",
    "playwright": "1.63.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "5.1.1"
  }
}
