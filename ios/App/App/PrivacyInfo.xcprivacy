<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App privacy manifest (round 11 §5). The app collects no data off the device (no server, no
  analytics, no tracking; sync is off). Required-reason APIs declared for the app's own use:
  UserDefaults (Capacitor configuration / WebView storage), CA92.1 = app-only data.
  Plugins (Capacitor, SQLite, secure storage, share, text-to-speech) ship their own manifests.
  To verify against a built archive: Xcode → Product → Archive → Generate Privacy Report.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
